{
  "name": "antideploy-mcp",
  "version": "0.2.0",
  "mcpName": "com.antideploy/antideploy-mcp",
  "description": "Deploy and run applications on Antideploy from a coding agent: Claude Code, Cursor, Codex, OpenCode. MCP server with a one-click browser login.",
  "type": "module",
  "bin": {
    "antideploy-mcp": "dist/antideploy-mcp.mjs"
  },
  "main": "dist/antideploy-mcp.mjs",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/e2e.test.mjs test/units.test.mjs test/packaging.test.mjs",
    "test:bundle": "node build.mjs && node scripts/with-entry.mjs dist/antideploy-mcp.mjs -- node --test test/e2e.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "agent-skills",
    "deploy",
    "deployment",
    "paas",
    "hosting",
    "claude",
    "claude-code",
    "cursor",
    "codex",
    "opencode",
    "coding-agent",
    "antideploy"
  ],
  "license": "MIT",
  "author": "Antideploy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antideploy/antideploy-mcp.git"
  },
  "homepage": "https://antideploy.com/docs/deploying/mcp",
  "bugs": {
    "url": "https://github.com/antideploy/antideploy-mcp/issues"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "esbuild": "^0.28.2",
    "tar": "^7.5.22",
    "zod": "^4.4.3"
  }
}
